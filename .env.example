# Salin file ini menjadi ".env", lalu isi key milikmu.
# JANGAN unggah file .env ke GitHub dan jangan bagikan isinya.

# Pilih penyedia: groq atau gemini
AI_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=

# Opsional: ganti model jika yang bawaan sudah tidak tersedia
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.5-flash
